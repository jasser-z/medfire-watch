FIRMS_MAP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security and API guard configuration (optional)
# Require X-MedFire-Token header on DELETE /alerts/history, POST /telegram/detect and all upload/POST endpoints
MEDFIRE_API_TOKEN=
# Additional allowed Host header hostnames (comma-separated, e.g. api.example.com)
MEDFIRE_ALLOWED_HOSTS=
# Additional allowed request origins for non-GET requests (comma-separated, e.g. https://dashboard.example.com)
MEDFIRE_ALLOWED_ORIGINS=

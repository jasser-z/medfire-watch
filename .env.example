FIRMS_MAP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Blank token: trusted loopback development only. Use a strong random token remotely.
# Protects sensitive reads and all writes. Browser media pages offer an HttpOnly session login.
MEDFIRE_API_TOKEN=
# Exact extra Host names; this is header validation, not a network access-control list.
MEDFIRE_ALLOWED_HOSTS=
# Exact extra origins for writes; no permissive CORS headers are enabled.
MEDFIRE_ALLOWED_ORIGINS=

# Video retention after worker completion, 0..8760 hours (0 expires on next sweep).
MEDFIRE_VIDEO_TTL_HOURS=24
# Atomic reservations include upload, preparation, analysis and export; 1..16.
MEDFIRE_MAX_VIDEO_JOBS=2
# Maximum registered jobs including retained terminal jobs, 1..4096.
MEDFIRE_MAX_STORED_VIDEO_JOBS=64
# Application upload-body deadline, 1..3600 seconds; proxy limits are also required remotely.
MEDFIRE_VIDEO_UPLOAD_TIMEOUT_SECONDS=300
# Camera trackers, 1..1024; idle sessions expire after 300 seconds.
MEDFIRE_MAX_CAMERA_SESSIONS=64
MEDFIRE_INCLUDE_LOW_CONFIDENCE=0
MEDFIRE_SKIP_WARMUP=0

# Launcher normally sets these; use the same hostname for dashboard and API browser cookies.
# MEDFIRE_API_URL=http://127.0.0.1:8000
# MEDFIRE_PUBLIC_API_URL=http://127.0.0.1:8000
# STREAMLIT_SERVER_PORT=8501
# Optional historical alert showcase, disabled by default.
MEDFIRE_SHOWCASE_ALERT=0

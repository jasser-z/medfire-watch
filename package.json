{
  "name": "medfire-watch-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=tests/** --test tests/*.test.mjs",
    "format": "prettier --write dashboard tests/*.mjs scripts/*.mjs",
    "format:check": "prettier --check dashboard/*.html dashboard/*.mjs tests/*.mjs scripts/*.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.12",
    "prettier": "^3.6.2"
  }
}
